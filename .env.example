# Copier en .env (jamais commité) et remplir.
# Une ligne par variable, sans guillemets.

# Clé de l'API Gemini (https://aistudio.google.com/apikey). Sans elle, l'app tourne hors ligne.
# Vérifier ensuite avec : uv run python -m ml.check_gemini
GEMINI_API_KEY=

# Facultatif : modèle de génération et modèle d'embedding
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Facultatif : endpoint d'API personnalisé (passerelle régionale, proxy ou Vertex AI)
# GEMINI_API_ROOT=https://generativelanguage.googleapis.com/v1beta

# Clé de l'API Claude (https://platform.claude.com). Avec elle, Claude écrit les demandes à la
# place de Gemini ; la position des demandes est mesurée par le modèle d'embeddings local.
ANTHROPIC_API_KEY=
# Facultatif : modèle (par défaut claude-opus-5-5 ; claude-haiku-5-5 coûte environ 40 fois moins)
# CLAUDE_MODEL=claude-opus-5-5

# Montre Garmin (uv run python -m garmin). Le mot de passe Garmin ne va jamais ici :
# `uv run python -m garmin login` le demande une fois et garde des jetons hors du repo.
# Facultatif : où garder ces jetons (par défaut ~/.garminconnect).
# GARMINTOKENS=
# Jeton du patient qui reçoit θ ; dans la console de son navigateur :
# localStorage.getItem('needed.token.patient')
NEEDED_PATIENT_TOKEN=
# Facultatif : adresse de l'API (par défaut http://localhost:8000).
# NEEDED_API_URL=
