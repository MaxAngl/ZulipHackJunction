# Copier en .env (jamais commité) et remplir.
# Une ligne par variable, sans guillemets.

# Clé de l'API Gemini (https://aistudio.google.com/apikey). Sans elle, l'app tourne hors ligne.
# Vérifier ensuite avec : uv run python -m ml.check_gemini
GEMINI_API_KEY=

# Facultatif : changer de modèle si l'un des deux est refusé par l'API.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001
