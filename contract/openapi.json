  "components": {
    "schemas": {
      "CandidateState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "pair": {
            "$ref": "#/components/schemas/InterestPair"
          },
          "lam": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Lam",
            "description": "Position mesurée sur l'axe λ"
          },
          "intended": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intended",
            "description": "Position visée par le générateur"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "format_label": {
            "type": "string",
            "title": "Format Label"
          },
          "effort": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Effort"
          },
          "in_zone": {
            "type": "boolean",
            "title": "In Zone"
          },
          "off_topic": {
            "type": "boolean",
            "title": "Off Topic"
          },
          "slot": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "best",
                  "bridge",
                  "explore"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot",
            "description": "Case occupée parmi les trois propositions"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gemini",
              "offline"
            ],
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "pair",
          "lam",
          "intended",
          "format",
          "format_label",
          "effort",
          "in_zone",
          "off_topic",
          "slot",
          "provider"
        ],
        "title": "CandidateState",
        "description": "Une demande générée, puis mesurée."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Identifiant machine en snake_case, ex. validation_error"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Message lisible par un humain"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Format unique de toutes les erreurs renvoyées par l'API."
      },
      "FormatState": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "effort": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Effort"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "effort"
        ],
        "title": "FormatState",
        "description": "Un format de la grille fixe, avec l'effort qu'il demande au patient."
      },
      "GeneratorState": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "gemini",
              "offline"
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "note"
        ],
        "title": "GeneratorState"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "HistoryEntry": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "helper_name": {
            "type": "string",
            "title": "Helper Name"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "lam": {
            "type": "number",
            "title": "Lam"
          },
          "effort": {
            "type": "number",
            "title": "Effort"
          },
          "format_label": {
            "type": "string",
            "title": "Format Label"
          },
          "source": {
            "type": "string",
            "enum": [
              "suggested",
              "edited",
              "real_need"
            ],
            "title": "Source"
          },
          "action": {
            "type": "string",
            "enum": [
              "helped",
              "ignored"
            ],
            "title": "Action"
          },
          "theta_before": {
            "type": "number",
            "title": "Theta Before"
          },
          "theta_expected": {
            "type": "number",
            "title": "Theta Expected"
          },
          "theta_after": {
            "type": "number",
            "title": "Theta After"
          },
          "reward": {
            "type": "number",
            "title": "Reward",
            "description": "θ après − θ attendu"
          },
          "center_before": {
            "type": "number",
            "title": "Center Before"
          },
          "center_after": {
            "type": "number",
            "title": "Center After",
            "description": "Centre de la zone au même θ, après apprentissage"
          }
        },
        "type": "object",
        "required": [
          "number",
          "helper_name",
          "text",
          "lam",
          "effort",
          "format_label",
          "source",
          "action",
          "theta_before",
          "theta_expected",
          "theta_after",
          "reward",
          "center_before",
          "center_after"
        ],
        "title": "HistoryEntry"
      },
      "InterestPair": {
        "properties": {
          "patient_interest": {
            "type": "string",
            "title": "Patient Interest"
          },
          "helper_interest": {
            "type": "string",
            "title": "Helper Interest"
          }
        },
        "type": "object",
        "required": [
          "patient_interest",
          "helper_interest"
        ],
        "title": "InterestPair"
      },
      "LoopState": {
        "properties": {
          "patient": {
            "$ref": "#/components/schemas/Person"
          },
          "helpers": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "type": "array",
            "title": "Helpers"
          },
          "theta": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Theta",
            "description": "État du patient (capteur simulé)"
          },
          "formats": {
            "items": {
              "$ref": "#/components/schemas/FormatState"
            },
            "type": "array",
            "title": "Formats"
          },
          "zone": {
            "$ref": "#/components/schemas/ZoneState"
          },
          "round": {
            "$ref": "#/components/schemas/RoundState"
          },
          "held": {
            "items": {
              "$ref": "#/components/schemas/MessageState"
            },
            "type": "array",
            "title": "Held"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "type": "array",
            "title": "History"
          },
          "generator": {
            "$ref": "#/components/schemas/GeneratorState"
          },
          "model": {
            "$ref": "#/components/schemas/ModelState"
          }
        },
        "type": "object",
        "required": [
          "patient",
          "helpers",
          "theta",
          "formats",
          "zone",
          "round",
          "held",
          "history",
          "generator",
          "model"
        ],
        "title": "LoopState",
        "description": "Tout l'état de la démo : un patient, sa zone, la manche en cours et l'historique."
      },
      "MessageState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "helper_id": {
            "type": "string",
            "title": "Helper Id"
          },
          "pair": {
            "$ref": "#/components/schemas/InterestPair"
          },
          "lam": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Lam"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "format_label": {
            "type": "string",
            "title": "Format Label"
          },
          "effort": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Effort"
          },
          "source": {
            "type": "string",
            "enum": [
              "suggested",
              "edited",
              "real_need"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "delivered",
              "held"
            ],
            "title": "Status"
          },
          "hold_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hold Reason",
            "description": "Pourquoi le message est retenu, s'il l'est"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "helper_id",
          "pair",
          "lam",
          "format",
          "format_label",
          "effort",
          "source",
          "status",
          "hold_reason"
        ],
        "title": "MessageState",
        "description": "La demande envoyée par l'aidant, après mesure."
      },
      "ModelState": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "simulated",
            "title": "Kind",
            "default": "simulated"
          },
          "offset": {
            "type": "number",
            "title": "Offset",
            "description": "Correction personnelle du centre de la zone"
          },
          "observations": {
            "type": "integer",
            "title": "Observations"
          }
        },
        "type": "object",
        "required": [
          "offset",
          "observations"
        ],
        "title": "ModelState"
      },
      "Person": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "interests"
        ],
        "title": "Person"
      },
      "RespondRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "helped",
              "ignored"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "RespondRequest"
      },
      "RoundState": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "stage": {
            "type": "string",
            "enum": [
              "idle",
              "proposed",
              "held",
              "sent",
              "answered"
            ],
            "title": "Stage"
          },
          "step": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Step",
            "description": "Étape courante de la boucle, de 1 à 12"
          },
          "helper_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Helper Id"
          },
          "pairs": {
            "items": {
              "$ref": "#/components/schemas/InterestPair"
            },
            "type": "array",
            "title": "Pairs"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateState"
            },
            "type": "array",
            "title": "Candidates"
          },
          "message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "number",
          "stage",
          "step",
          "helper_id",
          "pairs",
          "candidates",
          "message"
        ],
        "title": "RoundState"
      },
      "SendRequest": {
        "properties": {
          "proposal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "title": "SendRequest",
        "description": "Choix de l'aidant : une proposition, une proposition modifiée, ou son propre texte."
      },
      "ThetaRequest": {
        "properties": {
          "theta": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Theta"
          }
        },
        "type": "object",
